236. Lowest Common Ancestor of a Binary Tree

Code: 

class Solution {
public:
    TreeNode* lowestCommonAncestor(TreeNode* root, TreeNode* p, TreeNode* q) {
        // Base case: if root is null or matches either p or q
        if (root == nullptr || root == p || root == q) {
            return root;
        }

        // Look for p and q in left and right subtrees
        TreeNode* left = lowestCommonAncestor(root->left, p, q);
        TreeNode* right = lowestCommonAncestor(root->right, p, q);

        // If both left and right return non-null, current root is the LCA
        if (left != nullptr && right != nullptr) {
            return root;
        }

        // Otherwise, return the non-null result (or null if both are null)
        return left != nullptr ? left : right;
    }
};
