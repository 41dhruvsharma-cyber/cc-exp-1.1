class Solution {
public:
    void backtrack(int index, vector<int>& nums, vector<int>& current, vector<vector<int>>& result) {
        // Add the current subset configuration to the result
        result.push_back(current);
        
        // Explore further elements to form larger subsets
        for (int i = index; i < nums.size(); ++i) {
            current.push_back(nums[i]);       // Include element
            backtrack(i + 1, nums, current, result); // Recurse for remaining elements
            current.pop_back();              // Backtrack (exclude element)
        }
    }

    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> result;
        vector<int> current;
        backtrack(0, nums, current, result);
        return result;
    }
};


